# Copy to .env and fill in. .env is gitignored, never commit real values.

# Telegram bot token from @BotFather, and the chat/group ID that receives alerts.
# Leave empty to run without alerts (the web demo then only shows a preview).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (defaults shown)
# RIVERGUARD_MODEL=models/best.pt
# RIVERGUARD_CONF=0.35
# RIVERGUARD_THRESHOLD=5
# RIVERGUARD_COOLDOWN=20

# Only needed for retraining (training/):
# Roboflow > Settings > API Keys
ROBOFLOW_API_KEY=
# kaggle.com > Settings > API > Create New Token
KAGGLE_API_TOKEN=
